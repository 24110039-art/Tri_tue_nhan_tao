# ROBOT ICON – vẽ bằng QPainter, trả về QPixmap
# ─────────────────────────────────────────────────────────────

def make_robot_pixmap(size=60):
    px = QPixmap(size, size)
    px.fill(Qt.GlobalColor.transparent)
    p = QPainter(px)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    cx, cy = size // 2, size // 2
    r = size // 2 - 3

    # glow
    grad = QRadialGradient(cx, cy, r)
    grad.setColorAt(0,   QColor(100, 200, 255, 180))
    grad.setColorAt(0.6, QColor(30,  120, 220, 140))
    grad.setColorAt(1,   QColor(10,   60, 180,   0))
    p.setBrush(QBrush(grad))
    p.setPen(Qt.PenStyle.NoPen)
    p.drawEllipse(2, 2, size - 4, size - 4)

    # body
    p.setBrush(QBrush(QColor(30, 130, 230)))
    p.setPen(QPen(QColor(255, 255, 255), 2))
    body_r = int(r * 0.72)
    p.drawEllipse(cx - body_r, cy - body_r, body_r * 2, body_r * 2)

    # face plate
    p.setBrush(QBrush(QColor(20, 60, 140)))
    p.setPen(Qt.PenStyle.NoPen)
    fp = int(body_r * 0.6)
    p.drawEllipse(cx - fp, cy - fp, fp * 2, fp * 2)

    # left eye
    p.setBrush(QBrush(QColor(0, 255, 200)))
    ew = max(4, size // 12)
    p.drawEllipse(cx - body_r // 3 - ew // 2, cy - body_r // 4 - ew // 2, ew, ew)
    # right eye
    p.drawEllipse(cx + body_r // 3 - ew // 2, cy - body_r // 4 - ew // 2, ew, ew)

    # mouth (arc)
    p.setPen(QPen(QColor(0, 255, 200), max(2, size // 18)))
    p.setBrush(Qt.BrushStyle.NoBrush)
    mouth_r = int(body_r * 0.35)
    p.drawArc(cx - mouth_r, cy + mouth_r // 3, mouth_r * 2, mouth_r, 0, -180 * 16)

    # suction ring
    p.setPen(QPen(QColor(255, 200, 0), max(2, size // 16)))
    ring_r = int(r * 0.88)
    p.drawArc(cx - ring_r, cy - ring_r, ring_r * 2, ring_r * 2, 210 * 16, 120 * 16)

    p.end()
    return px


