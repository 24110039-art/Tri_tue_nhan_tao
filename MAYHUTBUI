CELL_SIZE = 65

class Cell(QPushButton):
    def __init__(self, row, col):
        super().__init__()
        self.row = row
        self.col = col
        self.state   = 0   # 0=sạch 1=bụi 2=vật cản
        self.cleaned = False
        self.setFixedSize(CELL_SIZE, CELL_SIZE)
        self.update_color()

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.state   = (self.state + 1) % 3
            self.cleaned = False
            self.update_color()

    def update_color(self):
        if self.state == 2:
            self.setStyleSheet("QPushButton{background:#222;border:1px solid #555;}")
            self.setText("")
        elif self.cleaned:
            self.setStyleSheet("QPushButton{background:#6FAEFF;border:1px solid #999;}")
            self.setText("")
        elif self.state == 1:
            self.setStyleSheet("""
                QPushButton{background:white;border:1px solid #999;
                            color:#8B5A2B;font-size:26px;font-weight:bold;}
            """)
            self.setText("✹")
        else:
            self.setStyleSheet("QPushButton{background:white;border:1px solid #999;}")
            self.setText("")


# ─────────────────────────────────────────────────────────────
# ROBOT OVERLAY LABEL  (nằm trên grid_widget)
# ─────────────────────────────────────────────────────────────

class RobotLabel(QLabel):
    def __init__(self, parent):
        super().__init__(parent)
        self.setFixedSize(CELL_SIZE, CELL_SIZE)
        px = make_robot_pixmap(CELL_SIZE - 6)
        lbl_px = QPixmap(CELL_SIZE, CELL_SIZE)
        lbl_px.fill(Qt.GlobalColor.transparent)
        p = QPainter(lbl_px)
        p.drawPixmap(3, 3, px)
        p.end()
        self.setPixmap(lbl_px)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.raise_()
        self.hide()

    def move_to_cell(self, r, c):
        spacing = 4
        margin  = 4
        self.move(
            margin + c * (CELL_SIZE + spacing),
            margin + r * (CELL_SIZE + spacing),
        )
        self.show()
        self.raise_()


