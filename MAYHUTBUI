    def show_principle(self, name):
        self.principle_text.clear()
        self.principle_text.append(self.PRINCIPLES.get(name, ""))

    # ──────────────────────────────────────
    # CHOOSE ALGO
    # ──────────────────────────────────────

    def choose_algorithm(self, name):
        self.algorithm = name
        self.status_label.setText(f"Trạng thái: Đã chọn {name}")
        self.show_principle(name)

    # ──────────────────────────────────────
    # GRID
    # ──────────────────────────────────────

    def create_grid(self):
        self.rows = self.row_spin.value()
        self.cols = self.col_spin.value()

        while self.grid_layout.count():
            item = self.grid_layout.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()

        self.cells = []
        for r in range(self.rows):
            row = []
            for c in range(self.cols):
                cell = Cell(r, c)
                self.grid_layout.addWidget(cell, r, c)
                row.append(cell)
            self.cells.append(row)

        spacing = 4
        margin  = 4
        self.grid_widget.setFixedSize(
            margin * 2 + self.cols * CELL_SIZE + (self.cols - 1) * spacing,
            margin * 2 + self.rows * CELL_SIZE + (self.rows - 1) * spacing,
        )
        self.robot_label.hide()

    def random_grid(self):
        for r in range(self.rows):
            for c in range(self.cols):
                self.cells[r][c].state   = random.choice([0, 0, 0, 1, 1, 2])
                self.cells[r][c].cleaned = False
                self.cells[r][c].update_color()
        self.robot_label.hide()

    def reset_grid(self):
        self.timer.stop()
        for r in range(self.rows):
            for c in range(self.cols):
                self.cells[r][c].state   = 0
                self.cells[r][c].cleaned = False
                self.cells[r][c].update_color()
        self.task_text.clear()
        self.solution_text.clear()
        self.status_label.setText("Trạng thái: Sẵn sàng")
        self.robot_label.hide()

    # ──────────────────────────────────────
    # PICK RANDOM START
    # ──────────────────────────────────────

    def pick_random_start(self):
        """Chọn ngẫu nhiên ô không phải vật cản làm vị trí bắt đầu."""
        candidates = [
            (r, c)
            for r in range(self.rows)
            for c in range(self.cols)
            if self.cells[r][c].state != 2
        ]
        if not candidates:
            return (0, 0)
        return random.choice(candidates)

    # ──────────────────────────────────────
    # NEIGHBORS
    # ──────────────────────────────────────

    def neighbors(self, r, c, reverse=False):
        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
        if reverse:
            dirs = list(reversed(dirs))
        result = []
        for dr, dc in dirs:
            nr, nc = r + dr, c + dc
            if 0 <= nr < self.rows and 0 <= nc < self.cols:
                if self.cells[nr][nc].state != 2:
                    result.append((nr, nc))
        return result

    # ──────────────────────────────────────
    # HEURISTIC
    # ──────────────────────────────────────

    def heuristic(self, r, c):
        min_dist = float('inf')
        for row in range(self.rows):
            for col in range(self.cols):
                cell = self.cells[row][col]
                if cell.state == 1 and not cell.cleaned:
                    d = abs(r - row) + abs(c - col)
                    if d < min_dist:
                        min_dist = d
        return min_dist if min_dist != float('inf') else 0

    # ──────────────────────────────────────
    # START
    # ──────────────────────────────────────

    def start_algorithm(self):
        self.timer.stop()
        self.task_text.clear()
        self.solution_text.clear()
        self.show_principle(self.algorithm)

        # reset cleaned state (giữ nguyên bụi / vật cản)
        for r in range(self.rows):
            for c in range(self.cols):
                if self.cells[r][c].state != 2:
                    self.cells[r][c].cleaned = False
                    self.cells[r][c].update_color()

        # random start
        start = self.pick_random_start()
        self.start_pos = start
        self.task_text.append(
            f"<b>🎲 Vị trí bắt đầu ngẫu nhiên: <span style='color:#E67E22;'>{start}</span></b><br>"
        )

        # đặt robot ngay tại start
        self.robot_label.move_to_cell(*start)

        algo = self.algorithm
        if algo == "BFS1":
            self.path = self.bfs(start, reverse=False)
        elif algo == "BFS2":
            self.path = self.bfs(start, reverse=True)
        elif algo == "DFS1":
            self.path = self.dfs(start, push_reversed=True)
        elif algo == "DFS2":
            self.path = self.dfs(start, push_reversed=False)
        elif algo == "IDS":
            self.path = self.ids(start)
        elif algo == "Greedy":
            self.path = self.greedy(start)
        elif algo == "A*":
            self.path = self.astar(start)

        self.current_step = 0
        self.timer.start(400)

    # ──────────────────────────────────────
    # BFS
    # ──────────────────────────────────────

    def bfs(self, start, reverse=False):
        queue   = deque([start])
        visited = set()
        path    = []
        step    = 0
        color   = "blue"
        label   = "BFS2" if reverse else "BFS1"

        self.task_text.append(
            f"<b style='color:{color};'>── {label} bắt đầu từ {start} ──</b>"
        )
        while queue:
            node = queue.popleft()
            if node in visited:
                continue
            visited.add(node)
            path.append(node)
            nb_list = self.neighbors(*node, reverse=reverse)
            self.task_text.append(
                f"<span style='color:{color};'>Bước {step}:</span> "
                f"Thăm <b>{node}</b> | Hàng xóm: {nb_list}"
            )
            step += 1
            for nb in nb_list:
                if nb not in visited:
                    queue.append(nb)
        return path

    # ──────────────────────────────────────
    # DFS
    # ──────────────────────────────────────

    def dfs(self, start, push_reversed=True):
        stack   = [start]
        visited = set()
        path    = []
        step    = 0
        color   = "#27AE60"
        label   = "DFS1" if push_reversed else "DFS2"

        self.task_text.append(
            f"<b style='color:{color};'>── {label} bắt đầu từ {start} ──</b>"
        )
        while stack:
            node = stack.pop()
            if node in visited:
                continue
            visited.add(node)
            path.append(node)
            nb_list   = self.neighbors(*node)
            push_list = list(reversed(nb_list)) if push_reversed else nb_list
            self.task_text.append(
                f"<span style='color:{color};'>Bước {step}:</span> "
                f"Thăm <b>{node}</b> | Stack push: {[n for n in push_list if n not in visited]}"
            )
            step += 1
            for nb in push_list:
                if nb not in visited:
                    stack.append(nb)
        return path

    # ──────────────────────────────────────
    # IDS
    # ──────────────────────────────────────

    def ids(self, start):
        color       = "#8E44AD"
        visited_all = []
        seen_global = set()

        self.task_text.append(
            f"<b style='color:{color};'>── IDS bắt đầu từ {start} ──</b>"
        )
        for depth_limit in range(self.rows * self.cols + 1):
            self.task_text.append(
                f"<span style='color:{color};'><b>Vòng lặp độ sâu l = {depth_limit}</b></span>"
            )
            _, found = self._depth_limited_search(
                start, depth_limit, color, visited_all, seen_global
            )
            if found:
                break

        seen = set()
        path = []
        for n in visited_all:
            if n not in seen:
                seen.add(n)
                path.append(n)
        return path

    def _depth_limited_search(self, start, limit, color, visited_all, seen_global):
        stack         = [(start, 0)]
        local_visited = set()

        while stack:
            node, depth = stack.pop()
            if node in local_visited:
                continue
            local_visited.add(node)
            if node not in seen_global:
                seen_global.add(node)
                visited_all.append(node)
            self.task_text.append(
                f"&nbsp;&nbsp;<span style='color:{color};'>Thăm</span> "
                f"<b>{node}</b> (sâu {depth}/{limit})"
            )
            if depth == limit:
                continue
            for nb in reversed(self.neighbors(*node)):
                if nb not in local_visited:
                    stack.append((nb, depth + 1))

        all_reachable = self._count_reachable(start)
        found = len(seen_global) >= all_reachable
        return visited_all, found

    def _count_reachable(self, start):
        queue   = deque([start])
        visited = {start}
        while queue:
            node = queue.popleft()
            for nb in self.neighbors(*node):
                if nb not in visited:
                    visited.add(nb)
                    queue.append(nb)
        return len(visited)

    # ──────────────────────────────────────
    # GREEDY
    # ──────────────────────────────────────

    def greedy(self, start):
        color   = "#E67E22"
        counter = 0
        h_start = self.heuristic(*start)
        frontier = [(h_start, counter, start)]
        heapq.heapify(frontier)
        reached = set()
        path    = []
        step    = 0

        self.task_text.append(
            f"<b style='color:{color};'>── Greedy bắt đầu từ {start} ──</b>"
        )
        while frontier:
            h_val, _, node = heapq.heappop(frontier)
            if node in reached:
                continue
            reached.add(node)
            path.append(node)
            self.task_text.append(
                f"<span style='color:{color};'>Bước {step}:</span> "
                f"Chọn <b>{node}</b> | h(n)=<b>{h_val}</b>"
            )
            step += 1
            for nb in self.neighbors(*node):
                if nb not in reached:
                    counter += 1
                    h_nb = self.heuristic(*nb)
                    heapq.heappush(frontier, (h_nb, counter, nb))
                    self.task_text.append(
                        f"&nbsp;&nbsp;→ Thêm {nb} | h={h_nb}"
                    )
        return path

    # ──────────────────────────────────────
    # A*
    # ──────────────────────────────────────

    def astar(self, start):
        color   = "#C0392B"
        g       = {start: 0}
        h_start = self.heuristic(*start)
        counter = 0
        frontier = [(h_start, counter, start)]
        heapq.heapify(frontier)
        reached = {}
        path    = []
        step    = 0

        self.task_text.append(
            f"<b style='color:{color};'>── A* bắt đầu từ {start} ──</b>"
        )
        while frontier:
            f_val, _, node = heapq.heappop(frontier)
            if node in reached:
                continue
            reached[node] = g.get(node, float('inf'))
            path.append(node)
            g_node = g.get(node, 0)
            h_node = self.heuristic(*node)
            self.task_text.append(
                f"<span style='color:{color};'>Bước {step}:</span> "
                f"Chọn <b>{node}</b> | g={g_node}, h={h_node}, f={g_node+h_node}"
            )
            step += 1
            for nb in self.neighbors(*node):
                g_new = g_node + 1
                if nb not in g or g_new < g[nb]:
                    g[nb]    = g_new
                    h_nb     = self.heuristic(*nb)
                    f_nb     = g_new + h_nb
                    counter += 1
                    heapq.heappush(frontier, (f_nb, counter, nb))
                    self.task_text.append(
                        f"&nbsp;&nbsp;→ Cập nhật {nb} | g={g_new}, h={h_nb}, f={f_nb}"
                    )
        return path

    # ──────────────────────────────────────
    # ANIMATION
    # ──────────────────────────────────────

    def run_animation(self):
        # ── HOÀN THÀNH ──
        if self.current_step >= len(self.path):
            self.timer.stop()

            remain = sum(
                1 for r in range(self.rows)
                for c in range(self.cols)
                if self.cells[r][c].state == 1 and not self.cells[r][c].cleaned
            )

            if remain > 0:
                self.status_label.setText("Trạng thái: Không có giải pháp!")
                self.task_text.append(
                    "<br><b style='color:red;'>==> Không thể dọn sạch toàn bộ bụi!</b>"
                )
                self.solution_text.clear()
                self.solution_text.append(
                    "<h2 style='color:red;'>KHÔNG TỒN TẠI GIẢI PHÁP</h2>"
                    f"<p>Còn lại {remain} ô bụi không tiếp cận được.</p>"
                )
            else:
                self.status_label.setText("Trạng thái: Hoàn thành! ✅")
                self.task_text.append(
                    "<br><b style='color:green;'>==> Hoàn thành! ✅</b>"
                )
                self.show_final_solution()
            return

        # ── DI CHUYỂN ROBOT ──
        r, c = self.path[self.current_step]
        cell = self.cells[r][c]

        # di chuyển icon robot
        self.robot_label.move_to_cell(r, c)

        # ô trước đó tô xanh (nếu không phải vật cản)
        if self.current_step > 0:
            pr, pc = self.path[self.current_step - 1]
            prev_cell = self.cells[pr][pc]
            if prev_cell.state != 2:
                prev_cell.cleaned = True
                prev_cell.update_color()

        # ô hiện tại: hút bụi ngay lập tức
        if cell.state == 1:
            cell.state   = 0
            cell.cleaned = True
            cell.update_color()
        elif cell.state == 0:
            cell.cleaned = True
            cell.update_color()

        # log
        color_map = {
            "BFS1": "blue",    "BFS2": "blue",
            "DFS1": "#27AE60", "DFS2": "#27AE60",
            "IDS":  "#8E44AD", "Greedy": "#E67E22", "A*": "#C0392B",
        }
        color = color_map.get(self.algorithm, "black")

        dust_info = " → 🧹 <b>Phát hiện bụi → Đã hút sạch!</b>" if cell.state == 0 and cell.cleaned else " → ✓ Ô sạch"
        # nếu bụi vừa bị hút, state đã là 0
        had_dust = (cell.cleaned and self.current_step < len(self.path))

        self.task_text.append(
            f"<span style='color:{color};'>▶ Bước {self.current_step}:</span> "
            f"Robot đến <b>({r},{c})</b>{dust_info}"
        )

        sb = self.task_text.verticalScrollBar()
        sb.setValue(sb.maximum())

        self.status_label.setText(
            f"Đang chạy: {self.algorithm} | Bước {self.current_step} | Robot tại ({r},{c})"
        )
        self.current_step += 1


    # ──────────────────────────────────────
    # SILENT ALGO RUNNERS (không log task)
    # ──────────────────────────────────────

    def _silent_bfs(self, start, reverse=False):
        queue   = deque([start])
        visited = set()
        path    = []
        while queue:
            node = queue.popleft()
            if node in visited:
                continue
            visited.add(node)
            path.append(node)
            for nb in self.neighbors(*node, reverse=reverse):
                if nb not in visited:
                    queue.append(nb)
        return path

    def _silent_dfs(self, start, push_reversed=True):
        stack   = [start]
        visited = set()
        path    = []
        while stack:
            node = stack.pop()
            if node in visited:
                continue
            visited.add(node)
            path.append(node)
            nb_list   = self.neighbors(*node)
            push_list = list(reversed(nb_list)) if push_reversed else nb_list
            for nb in push_list:
                if nb not in visited:
                    stack.append(nb)
        return path

    def _silent_ids(self, start):
        visited_all = []
        seen_global = set()
        for depth_limit in range(self.rows * self.cols + 1):
            stack         = [(start, 0)]
            local_visited = set()
            while stack:
                node, depth = stack.pop()
                if node in local_visited:
                    continue
                local_visited.add(node)
                if node not in seen_global:
                    seen_global.add(node)
                    visited_all.append(node)
                if depth == depth_limit:
                    continue
                for nb in reversed(self.neighbors(*node)):
                    if nb not in local_visited:
                        stack.append((nb, depth + 1))
            if len(seen_global) >= self._count_reachable(start):
                break
        seen = set()
        path = []
        for n in visited_all:
            if n not in seen:
                seen.add(n)
                path.append(n)
        return path

    def _silent_greedy(self, start):
        counter  = 0
        frontier = [(self.heuristic(*start), counter, start)]
        heapq.heapify(frontier)
        reached  = set()
        path     = []
        while frontier:
            h_val, _, node = heapq.heappop(frontier)
            if node in reached:
                continue
            reached.add(node)
            path.append(node)
            for nb in self.neighbors(*node):
                if nb not in reached:
                    counter += 1
                    heapq.heappush(frontier, (self.heuristic(*nb), counter, nb))
        return path

    def _silent_astar(self, start):
        g        = {start: 0}
        counter  = 0
        frontier = [(self.heuristic(*start), counter, start)]
        heapq.heapify(frontier)
        reached  = {}
        path     = []
        while frontier:
            f_val, _, node = heapq.heappop(frontier)
            if node in reached:
                continue
            reached[node] = g.get(node, float('inf'))
            path.append(node)
            g_node = g.get(node, 0)
            for nb in self.neighbors(*node):
                g_new = g_node + 1
                if nb not in g or g_new < g[nb]:
                    g[nb] = g_new
                    counter += 1
                    heapq.heappush(frontier, (g_new + self.heuristic(*nb), counter, nb))
        return path

    def _run_all_silent(self, start):
        """Chạy tất cả 7 thuật toán silent, trả về dict {algo: path}."""
        return {
            "BFS1":   self._silent_bfs(start, reverse=False),
            "BFS2":   self._silent_bfs(start, reverse=True),
            "DFS1":   self._silent_dfs(start, push_reversed=True),
            "DFS2":   self._silent_dfs(start, push_reversed=False),
            "IDS":    self._silent_ids(start),
            "Greedy": self._silent_greedy(start),
            "A*":     self._silent_astar(start),
        }

    # ──────────────────────────────────────
    # FINAL SOLUTION WITH COMPARISON
    # ──────────────────────────────────────

    def _count_dust_cleaned(self, path):
        """Đếm số ô bụi (state==1) xuất hiện trong path."""
        cleaned = 0
        seen_dust = set()
        for r, c in path:
            if self.cells[r][c].state == 1 and (r, c) not in seen_dust:
                cleaned += 1
                seen_dust.add((r, c))
        return cleaned

    def show_final_solution(self):
